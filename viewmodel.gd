extends Node3D

# First-person weapon and arms. The meshes are generated by tools/make_gun.py
# and tools/make_arms.py; everything here is drawn with the weapon's own field
# of view (see viewmodel.gdshaderinc). The gun points down -Z and its sight
# line sits at y = SIGHT_Y.

const Assets := preload("res://assets.gd")

const SIGHT_Y := 0.066
const MUZZLE := Vector3(0, 0.0, -0.47)
const PORT := Vector3(0.026, 0.017, -0.03)      # ejection port, on the right side
# Centre of the support hand's grip, and the move that takes it from the
# foregrip to the magazine.
const FIST := Vector3(-0.02, -0.07, -0.185)
const GRAB := Vector3(0.0, -0.058, 0.095)
# Where the hand holds the magazine up during an inspect, in camera space.
const SHOW := Vector3(-0.073, -0.09, -0.3)

var flash: OmniLight3D
var flash_mesh: Node3D
var mag: Node3D
var left_arm: Node3D
var right_arm: Node3D
var bolt: Node3D             # pivot on the bore axis; the bolt mesh hangs under it
var bolt_part: MeshInstance3D
const BOLT_AXIS := Vector3(0, 0.016, 0)
# How the firing hand has to move to take hold of the bolt knob.
# Throwing: what each hand holds, and how far through its throw it is.
var left_throw := 0.0
var left_item := "blend"
var right_items := {}
var left_items := {}
const HAND_TO_KNOB := Vector3(0.028, 0.078, 0.0)

var weapon_mat: ShaderMaterial
var cloth: ShaderMaterial
var flash_mat: ShaderMaterial
var beam_mats: Array[ShaderMaterial] = []
var fx_balls: Array[MeshInstance3D] = []
var fx_tongues: Array[MeshInstance3D] = []
var fx_jets: Array[MeshInstance3D] = []
var fx_star: Node3D
var fx_age := 1.0
var fx_time := 0.08
var fx_side := false

var _parent: Node3D
var gun_part: MeshInstance3D
var left_hand_part: MeshInstance3D
var right_hand_part: MeshInstance3D
var _right_on_bolt := 0
# Variations, picked by the player each time: the bolt worked with the hand over the
# knob or hooked under it (tools/make_arms.py right_bolt_hook), and two ways to reload.
var bolt_hook := false
var reload_style := 0
const HOOK_TURN := -100.0
const HOOK_KNOB := Vector3(0.009, -0.0642, 0.0566)
var left_sleeve_part: MeshInstance3D
var mag_part: MeshInstance3D
var barrel_part: MeshInstance3D
var optic_part: MeshInstance3D
var dot_part: MeshInstance3D
var ring_part: MeshInstance3D           # the holo sight's ring round its dot
var extra_parts: Array[MeshInstance3D] = []   # attachments: muzzle, grip, laser, stock, optic, mount
var laser_beam: Node3D
var two_handed := true
# The support hand's finger poses: on the grip, open on the way, round the magazine.
var plain_hold := false
var mag_hand := "left_mag_rifle_hand.bin"
var hold_offset := Vector3.ZERO
var _left_state := ""
var flash_size := 1.0
var _arm := Transform3D.IDENTITY     # where the support arm is right now
var _held := 0.0                     # 1 while the magazine travels with the hand
# Hands that give a little: springs for how far each hand is pushed off its spot
# (by a shot, or by the weapon swinging) and how it springs back.
var _left_give := Vector3.ZERO
var _left_give_vel := Vector3.ZERO
var _right_give := Vector3.ZERO
var _right_give_vel := Vector3.ZERO
var _last_basis := Basis.IDENTITY
var _life_t := 0.0


func _init() -> void:
	left_arm = Node3D.new()
	right_arm = Node3D.new()
	add_child(right_arm)
	bolt = Node3D.new()
	bolt.position = BOLT_AXIS
	add_child(bolt)
	add_child(left_arm)
	mag = Node3D.new()
	add_child(mag)
	_make_materials()

	_parent = self
	gun_part = _part("gun.bin", weapon_mat)
	barrel_part = _part("sniper_barrel_standard.bin", weapon_mat)
	optic_part = _part("sniper_optic_scope.bin", weapon_mat)
	# The reflex sight's dot: always drawn on top, so it sits on the window.
	dot_part = MeshInstance3D.new()
	var dot := SphereMesh.new()
	dot.radius = 0.0011
	dot.height = 0.0022
	dot_part.mesh = dot
	var glow := StandardMaterial3D.new()
	glow.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	glow.albedo_color = Color(1.0, 0.12, 0.08)
	glow.no_depth_test = true
	glow.render_priority = 10
	dot_part.material_override = glow
	dot_part.layers = 2
	dot_part.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(dot_part)
	# Holo sight: a thin ring round the dot.
	ring_part = MeshInstance3D.new()
	var ring := TorusMesh.new()
	ring.inner_radius = 0.0052
	ring.outer_radius = 0.0058
	ring_part.mesh = ring
	ring_part.rotation.x = PI / 2.0
	ring_part.material_override = glow
	ring_part.layers = 2
	ring_part.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(ring_part)
	# Laser beam: two crossed glowing strips out of the module, along -Z.
	laser_beam = Node3D.new()
	add_child(laser_beam)
	var beam_mat := ShaderMaterial.new()
	beam_mat.shader = load("res://beam.gdshader")
	beam_mats.append(beam_mat)
	var strip := QuadMesh.new()
	strip.size = Vector2(0.0035, 1.6)
	strip.center_offset = Vector3(0.0, 0.8, 0.0)
	for k in 2:
		var b := MeshInstance3D.new()
		b.mesh = strip
		b.material_override = beam_mat
		b.basis = Basis(Vector3.RIGHT, -PI / 2.0) * Basis(Vector3.UP, k * PI / 2.0)
		b.layers = 2
		b.extra_cull_margin = 4.0
		b.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		laser_beam.add_child(b)
	laser_beam.visible = false
	_parent = right_arm
	right_hand_part = _part("right_hand.bin", cloth)
	_part("right_sleeve.bin", cloth)
	_parent = bolt
	bolt_part = _part("sniper_bolt.bin", weapon_mat)
	bolt_part.position = -BOLT_AXIS
	_parent = self
	_parent = mag
	mag_part = _part("mag.bin", weapon_mat)
	_parent = left_arm
	left_hand_part = _part("left_hand.bin", cloth)
	left_sleeve_part = _part("left_sleeve.bin", cloth)
	_parent = self
	_build_flash()
	_build_held_items()

	# Soft fill so the weapon keeps its detail on the shaded side.
	var fill := OmniLight3D.new()
	fill.position = Vector3(-0.15, 0.25, 0.25)
	fill.omni_range = 1.4
	fill.light_energy = 0.3
	fill.light_specular = 0.7
	add_child(fill)


# Swaps in another weapon from weapons.gd.
# plain_hold: no foregrip fitted, so the support hand cups the fore-end from below.
func set_weapon(w: Dictionary, plain_hold := false) -> void:
	var file: String = w["mesh"]
	if plain_hold and w.has("nogrip_mesh"):
		file = w["nogrip_mesh"]
	gun_part.mesh = Assets.mesh(file)
	# Attachments: as many parts as the weapon's picks list.
	var parts: Array = w.get("parts", [])
	while extra_parts.size() < parts.size():
		_parent = self
		extra_parts.append(_part("", weapon_mat))
	for i in extra_parts.size():
		var m: MeshInstance3D = extra_parts[i]
		m.visible = i < parts.size()
		if m.visible:
			m.mesh = Assets.mesh(parts[i][0])
			m.position = parts[i][1]
	ring_part.visible = w.get("dot_ring", false)
	if ring_part.visible:
		ring_part.position = w["dot"]
	laser_beam.visible = w.has("laser_beam")
	if laser_beam.visible:
		laser_beam.position = w["laser_beam"]
	hold_offset = w.get("hold_offset", Vector3.ZERO)
	self.plain_hold = plain_hold
	mag_hand = "left_mag_sniper_hand.bin" if w.has("bolt") else "left_mag_rifle_hand.bin"
	_left_state = ""
	_set_left("grip")
	barrel_part.mesh = Assets.mesh(w["barrel"]) if w.has("barrel") else null
	optic_part.mesh = Assets.mesh(w["optic"]) if w.has("optic") else null
	dot_part.visible = w.has("dot")
	if w.has("dot"):
		dot_part.position = w["dot"]
	bolt.visible = w.has("bolt")
	pose_bolt(0.0)
	mag_part.mesh = Assets.mesh(w["mag"]) if w["mag"] != "" else null
	two_handed = w["two_handed"]
	left_arm.visible = two_handed
	flash_size = w["flash"]
	weapon_mat.set_shader_parameter("clip_z", float(w.get("clip_z", 100.0)))
	weapon_mat.set_shader_parameter("clip_y", float(w.get("clip_y", 100.0)))
	var muzzle: Vector3 = w["muzzle"]
	flash.position = muzzle + Vector3(0, 0, -0.04)
	flash_mesh.position = muzzle + Vector3(0, 0, -0.005)
	_arm = Transform3D.IDENTITY
	_held = 0.0


# Working the bolt, t from 0 to 1 (0 = at rest): the firing hand leaves the
# grip for the knob, lifts it, pulls the bolt back, pushes it home, turns it
# down and returns to the grip.
func pose_bolt(t: float) -> void:
	var lift := 0.0
	var slide := 0.0
	var reach := 0.0
	if t > 0.0:
		reach = smoothstep(0.0, 0.16, t) * (1.0 - smoothstep(0.84, 1.0, t))
		lift = smoothstep(0.14, 0.27, t) * (1.0 - smoothstep(0.68, 0.8, t))
		slide = smoothstep(0.3, 0.48, t) * (1.0 - smoothstep(0.52, 0.68, t))
	var turn := Basis(Vector3.BACK, deg_to_rad(62.0) * lift)
	bolt.transform = Transform3D(turn, BOLT_AXIS + Vector3(0, 0, 0.088 * slide))
	# The hand follows where the knob goes, but only turns a little itself, so the
	# forearm stays low instead of swinging up across the picture.
	var with_bolt := Transform3D(turn, BOLT_AXIS + Vector3(0, 0, 0.088 * slide)) * Transform3D(Basis.IDENTITY, -BOLT_AXIS)
	var knob := Vector3(0.054, 0.0, 0.079)
	var hand_turn := Basis(Vector3.RIGHT, deg_to_rad(-10.0)) * Basis(Vector3.BACK, deg_to_rad(16.0) * lift)
	var on_knob := Transform3D(hand_turn, HAND_TO_KNOB + (with_bolt * knob - knob))
	if bolt_hook:
		# Hook grip: the forearm turns palm-up and two fingers hook the knob from behind.
		var r := Basis((RIGHT_ELBOW - RIGHT_WRIST).normalized(), deg_to_rad(HOOK_TURN))
		on_knob = Transform3D(r, with_bolt * knob - r * HOOK_KNOB)
	right_arm.transform = Transform3D.IDENTITY.interpolate_with(on_knob, reach)
	# Close round the knob once the hand is there; back to the grip pose after.
	var on_bolt := 0 if reach <= 0.6 else (2 if bolt_hook else 1)
	if on_bolt != _right_on_bolt:
		_right_on_bolt = on_bolt
		right_hand_part.mesh = Assets.mesh(["right_hand.bin", "right_bolt_hand.bin", "right_bolt_hook_hand.bin"][on_bolt])


# A pose for an arm given in camera space: the arm's reference point `anchor`
# should end up at `at`, turned by `turn`. Returned in this node's own space.
func _cam_pose(at: Vector3, turn: Basis, anchor: Vector3) -> Transform3D:
	return transform.affine_inverse() * Transform3D(turn, at - turn * anchor)


# Where the wrist and the elbow of each arm mesh are (from tools/make_arms.py).
const RIGHT_WRIST := Vector3(0.036, -0.128, 0.15)
const RIGHT_ELBOW := Vector3(0.17, -0.3, 0.46)
const LEFT_WRIST := Vector3(-0.052, -0.105, -0.105)
const LEFT_ELBOW := Vector3(-0.27, -0.3, 0.22)

# Right-hand throwing poses in camera space: [elbow, wrist, roll of the forearm].
# The elbows stay out of the picture, so the sleeve's cut end never shows.
const KNIFE_READY := [Vector3(0.2, -0.38, -0.06), Vector3(0.17, -0.06, -0.3), 0.0]       # elbow tucked in, hand at head height
const KNIFE_COCKED := [Vector3(0.22, -0.36, -0.02), Vector3(0.21, 0.0, -0.18), 0.0]
const KNIFE_OUT := [Vector3(0.22, -0.32, -0.12), Vector3(0.1, -0.12, -0.4), 0.0]
const NADE_READY := [Vector3(0.24, -0.42, 0.02), Vector3(0.16, -0.18, -0.26), 0.0]
const NADE_COCKED := [Vector3(0.32, -0.2, 0.1), Vector3(0.3, 0.14, -0.02), 0.3]        # arm drawn back like a pitcher
const NADE_OUT := [Vector3(0.24, -0.28, -0.14), Vector3(0.1, -0.12, -0.46), 0.0]      # and stretched out after the ball


# The arm turned so its elbow sits at `at_elbow` and the forearm points at
# `at_wrist`, rolled about itself by `roll`. Starts from the arm's rest pose, so
# the hand keeps its twist; returned in this node's own space.
func _arm_to(wrist: Vector3, elbow: Vector3, key: Array) -> Transform3D:
	var e0 := transform * elbow
	var d0 := (transform * wrist - e0).normalized()
	var to: Vector3 = (key[1] - key[0]).normalized()
	var b := Basis(to, float(key[2])) * Basis(Quaternion(d0, to))
	var at_elbow: Vector3 = key[0]
	return transform.affine_inverse() * Transform3D(b, at_elbow - b * e0) * transform


func _rest_key(wrist: Vector3, elbow: Vector3) -> Array:
	return [transform * elbow, transform * wrist, 0.0]


func _mix(a: Array, b: Array, k: float) -> Array:
	k = smoothstep(0.0, 1.0, k)
	return [(a[0] as Vector3).lerp(b[0], k), (a[1] as Vector3).lerp(b[1], k), lerpf(a[2], b[2], k)]


# Right hand with lethal equipment: t up to 0.3 brings it up and holds it ready,
# 0.3-0.5 is the throw, the rest brings the hand back to the grip.
# The knife is flicked from beside the head; the grenade is pitched with the whole arm.
func pose_right_throw(t: float, item: String) -> void:
	for id: String in right_items:
		right_items[id].visible = id == item and t > 0.0 and t < 0.47
	if t <= 0.0:
		return
	var knife := item == "wurfmesser"
	var rest := _rest_key(RIGHT_WRIST, RIGHT_ELBOW)
	var ready: Array = KNIFE_READY if knife else NADE_READY
	var cocked: Array = KNIFE_COCKED if knife else NADE_COCKED
	var out: Array = KNIFE_OUT if knife else NADE_OUT
	var key: Array
	if t < 0.3:
		key = _mix(rest, ready, t / 0.3)
	elif t < 0.36:
		key = _mix(ready, cocked, (t - 0.3) / 0.06)
	elif t < 0.5:
		key = _mix(cocked, out, (t - 0.36) / 0.14)
	else:
		key = _mix(out, rest, (t - 0.5) / 0.5)
	right_arm.transform = _arm_to(RIGHT_WRIST, RIGHT_ELBOW, key)


# Sniper reload: the firing hand lets go of the grip and takes the fore-end from
# its right side while the support hand changes the magazine. k: 0 = on the
# grip, 1 = holding the fore-end. Positions are on the weapon, so the hand
# stays put on it however the rifle moves.
const FOREND_HOLD := Vector3(0.05, -0.045, -0.24)        # where the wrist sits
const FOREND_ELBOW := Vector3(0.21, -0.29, 0.06)
const FOREND_ROLL := 0.9


func pose_right_reload(k: float) -> void:
	if k <= 0.0:
		return
	var rest := _rest_key(RIGHT_WRIST, RIGHT_ELBOW)
	var hold := [transform * FOREND_ELBOW, transform * FOREND_HOLD, FOREND_ROLL]
	# Lift a little on the way, so the hand clears the scope's eyepiece and the bolt.
	var key := _mix(rest, hold, k)
	var arc := sin(PI * smoothstep(0.0, 1.0, k)) * 0.03
	key[0] += Vector3(0.0, arc * 0.5, 0.0)
	key[1] += Vector3(0.015, arc, 0.0)
	right_arm.transform = _arm_to(RIGHT_WRIST, RIGHT_ELBOW, key)


# Left hand lobbing tactical equipment: only the forearm swings, about the elbow,
# which barely moves. Up and back to wind up, then forward to let go.
func _left_throw_pose(t: float) -> Transform3D:
	var rest := _rest_key(LEFT_WRIST, LEFT_ELBOW)
	var fore: Vector3 = rest[1] - rest[0]
	var wind := [rest[0] + Vector3(0.0, -0.01, 0.02), rest[0] + Vector3(0.0, -0.01, 0.02) + fore.rotated(Vector3.RIGHT, deg_to_rad(18.0)).rotated(Vector3.UP, deg_to_rad(38.0)), 0.0]
	var let_go := [rest[0] + Vector3(-0.02, 0.03, -0.07), rest[0] + Vector3(-0.02, 0.03, -0.07) + fore.rotated(Vector3.RIGHT, deg_to_rad(-2.0)).rotated(Vector3.UP, deg_to_rad(10.0)), 0.0]
	var key: Array
	if t < 0.3:
		key = _mix(rest, wind, t / 0.3)
	elif t < 0.5:
		key = _mix(wind, let_go, (t - 0.3) / 0.2)
	else:
		key = _mix(let_go, rest, (t - 0.5) / 0.5)
	return _arm_to(LEFT_WRIST, LEFT_ELBOW, key)


func _held_mesh(parent: Node3D, kind: String, at: Vector3) -> Node3D:
	var holder := Node3D.new()
	holder.position = at
	parent.add_child(holder)
	var dark := StandardMaterial3D.new()
	dark.albedo_color = Color(0.05, 0.05, 0.05)
	dark.roughness = 0.7
	var steel := StandardMaterial3D.new()
	steel.albedo_color = Color(0.6, 0.61, 0.63)
	steel.metallic = 0.9
	steel.roughness = 0.25
	var parts := []
	match kind:
		"wurfmesser":
			# Held like the pistol grip, blade up and forward.
			parts = [[Vector3(0.012, 0.09, 0.02), dark, Vector3.ZERO], [Vector3(0.004, 0.12, 0.024), steel, Vector3(0, 0.105, -0.004)]]
		"granate":
			parts = [["ball", Color(0.17, 0.2, 0.11), Vector3(0, 0.0, 0)], [Vector3(0.018, 0.028, 0.018), steel, Vector3(0, 0.05, 0)]]
		_:
			parts = [["can", Color(0.32, 0.34, 0.33) if kind == "blend" else Color(0.18, 0.22, 0.3), Vector3.ZERO],
					[Vector3(0.014, 0.026, 0.014), steel, Vector3(0, 0.066, 0)]]
	for part: Array in parts:
		var m := MeshInstance3D.new()
		var mat: Material = part[1] if part[1] is Material else null
		if part[0] is Vector3:
			var b := BoxMesh.new()
			b.size = part[0]
			m.mesh = b
		elif part[0] == "ball":
			var sm := SphereMesh.new()
			sm.radius = 0.04
			sm.height = 0.085
			m.mesh = sm
			mat = StandardMaterial3D.new()
			(mat as StandardMaterial3D).albedo_color = part[1]
		else:
			var c := CylinderMesh.new()
			c.top_radius = 0.029
			c.bottom_radius = 0.029
			c.height = 0.11
			m.mesh = c
			mat = StandardMaterial3D.new()
			(mat as StandardMaterial3D).albedo_color = part[1]
		m.material_override = mat
		m.position = part[2]
		m.layers = 2
		m.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		holder.add_child(m)
	holder.rotation.x = deg_to_rad(-14.0)
	holder.visible = false
	return holder


func _build_held_items() -> void:
	for kind: String in ["wurfmesser", "granate"]:
		right_items[kind] = _held_mesh(right_arm, kind, Vector3(0.0, -0.098, 0.072))
	for kind: String in ["blend", "betaeubung"]:
		left_items[kind] = _held_mesh(left_arm, kind, FIST + Vector3(0.0, 0.0, 0.0))


# A shot shoves both hands a touch: the support hand slides back on the grip and
# rolls, the firing hand's wrist flexes. strength ~ the weapon's recoil.
func hand_shot(strength: float) -> void:
	_left_give_vel += Vector3(0.9, -0.5, 0.35) * strength
	_right_give_vel += Vector3(0.6, 0.0, 0.25) * strength


# Called every frame after the arms are posed. x: pitch of the hand, y: its
# roll, z: slide along the gun (all small). The weapon's own turning drags the
# hands behind it a little, and they breathe very slightly.
func hand_life(dt: float) -> void:
	_life_t += dt
	var turn := (_last_basis.inverse() * transform.basis).get_euler() / maxf(dt, 0.0001)
	_last_basis = transform.basis
	turn = turn.limit_length(6.0)
	_left_give_vel += Vector3(-turn.x * 6.0, turn.z * 7.0, 0.0) * dt
	_right_give_vel += Vector3(-turn.x * 3.5, turn.z * 4.5, 0.0) * dt
	_left_give_vel += (-_left_give * 220.0 - _left_give_vel * 15.0) * dt
	_left_give += _left_give_vel * dt
	_right_give_vel += (-_right_give * 260.0 - _right_give_vel * 17.0) * dt
	_right_give += _right_give_vel * dt
	var breathe := sin(_life_t * 1.7) * 0.004
	_apply_give(left_arm, FIST, _left_give + Vector3(breathe, breathe * 0.6, 0.0))
	_apply_give(right_arm, Vector3(0.0, -0.098, 0.072), _right_give)


func _apply_give(arm: Node3D, hand: Vector3, give: Vector3) -> void:
	var at := arm.transform * hand
	var turn := Basis(Vector3.RIGHT, give.x * 0.12) * Basis(Vector3.BACK, give.y * 0.12)
	var shift := Vector3(0.0, give.x * 0.0012, give.z * 0.006)
	arm.transform = Transform3D(turn, at - turn * at + shift) * arm.transform


# The weapon's own field of view in degrees (vertical).
func set_fov(degrees: float) -> void:
	for m: ShaderMaterial in [weapon_mat, cloth, flash_mat] + beam_mats:
		m.set_shader_parameter("vm_fov", degrees)


# Everything about the weapon and arms that moves, for the killcam to record...
func snapshot() -> Dictionary:
	var items: Array[String] = []
	for id: String in right_items:
		if right_items[id].visible:
			items.append("r" + id)
	for id: String in left_items:
		if left_items[id].visible:
			items.append("l" + id)
	return {"vm": transform, "la": left_arm.transform, "ra": right_arm.transform, "mag": mag.transform,
			"bolt": bolt.transform, "lv": left_arm.visible, "ls": _left_state, "rs": _right_on_bolt,
			"items": items, "laser": laser_beam.visible}


# ...and played back: a is the earlier snapshot, b the later, k how far between them.
func apply_snapshot(a: Dictionary, b: Dictionary, k: float) -> void:
	transform = (a["vm"] as Transform3D).interpolate_with(b["vm"], k)
	left_arm.transform = (a["la"] as Transform3D).interpolate_with(b["la"], k)
	right_arm.transform = (a["ra"] as Transform3D).interpolate_with(b["ra"], k)
	mag.transform = (a["mag"] as Transform3D).interpolate_with(b["mag"], k)
	bolt.transform = (a["bolt"] as Transform3D).interpolate_with(b["bolt"], k)
	left_arm.visible = b["lv"]
	_set_left(str(b["ls"]) if str(b["ls"]) != "" else "grip")
	var rs: int = b["rs"]
	if rs != _right_on_bolt:
		_right_on_bolt = rs
		right_hand_part.mesh = Assets.mesh(["right_hand.bin", "right_bolt_hand.bin", "right_bolt_hook_hand.bin"][rs])
	var items: Array = b["items"]
	for id: String in right_items:
		right_items[id].visible = items.has("r" + id)
	for id: String in left_items:
		left_items[id].visible = items.has("l" + id)
	laser_beam.visible = b["laser"]


# Swaps the support hand's mesh for a finger pose: "grip" (on the foregrip or the
# fore-end), "open" (relaxed, on its way) or "mag" (wrapped round the magazine).
func _set_left(state: String) -> void:
	if state == _left_state:
		return
	_left_state = state
	match state:
		"grip":
			left_hand_part.mesh = Assets.mesh("left_hold_hand.bin" if plain_hold else "left_hand.bin")
			left_sleeve_part.mesh = Assets.mesh("left_hold_sleeve.bin" if plain_hold else "left_sleeve.bin")
			left_hand_part.position = hold_offset
			left_sleeve_part.position = hold_offset
		"open":
			left_hand_part.mesh = Assets.mesh("left_open_hand.bin")
			left_sleeve_part.mesh = Assets.mesh("left_sleeve.bin")
			left_hand_part.position = Vector3.ZERO
			left_sleeve_part.position = Vector3.ZERO
		"mag":
			left_hand_part.mesh = Assets.mesh(mag_hand)
			left_sleeve_part.mesh = Assets.mesh("left_sleeve.bin")
			left_hand_part.position = Vector3.ZERO
			left_sleeve_part.position = Vector3.ZERO


# Which finger pose the support hand has at this point of a reload or inspect.
func _left_pose_for(reload: float, inspect: float) -> String:
	if reload > 0.0:
		if reload < 0.07 or reload >= 0.9:
			return "grip"
		if reload_style == 1 and reload >= 0.74:
			return "open"          # flat hand slapping the magazine home
		if reload < 0.15 or reload >= 0.8:
			return "open"
		return "mag"
	if inspect > 1.35:
		return "mag" if inspect > 1.95 else "open"
	return "grip"


# Places the support arm and the magazine for this frame.
# free: tactical sprint, 0 = on the foregrip, 1 = pumping beside the body.
# phase: step cycle. inspect: 0-1 both hands on, 1-2 the hand moves to the
# magazine, 2-3 it pulls the magazine out and holds it up. wobble: slow drift
# for the held magazine. reload: 0 = not reloading, otherwise progress 0-1.
func pose_left(dt: float, free: float, phase: float, inspect: float, wobble: Vector2, reload: float) -> void:
	for id: String in left_items:
		left_items[id].visible = id == left_item and left_throw > 0.0 and left_throw < 0.5
	if left_throw > 0.0:
		left_arm.transform = _left_throw_pose(left_throw)
		left_arm.visible = true
		_arm = left_arm.transform
		mag.transform = Transform3D.IDENTITY
		return
	left_arm.visible = two_handed
	_set_left(_left_pose_for(reload, inspect) if two_handed else "grip")
	if not two_handed:
		left_arm.transform = Transform3D.IDENTITY
		mag.transform = Transform3D.IDENTITY
		return
	var grab := Transform3D(Basis.IDENTITY, GRAB)
	var goal := Transform3D.IDENTITY
	var carrying := false
	# Swing out and around the trigger guard instead of cutting through it.
	var arc := Vector3(-0.04, -0.025, 0.0)

	if reload > 0.0:
		# Hand to the magazine, pull it down and away, bring a fresh one up, seat it, hand back.
		var away := Transform3D(Basis(Vector3.BACK, deg_to_rad(18.0)) * Basis(Vector3.RIGHT, deg_to_rad(-20.0)),
				GRAB + Vector3(-0.07, -0.36, 0.1))
		if reload < 0.16:
			var k := smoothstep(0.0, 1.0, reload / 0.16)
			goal = Transform3D(Basis.IDENTITY, GRAB * k + arc * sin(PI * k))
		elif reload < 0.4:
			var k := smoothstep(0.0, 1.0, (reload - 0.16) / 0.24)
			goal = grab.interpolate_with(away, k)
			goal.origin += Vector3(0.0, -0.07, 0.0) * sin(PI * k) * (1.0 - k) * 1.5
			carrying = true
		elif reload < 0.56:
			goal = away
			carrying = true
		elif reload < 0.8:
			var k := smoothstep(0.0, 1.0, (reload - 0.56) / 0.24)
			goal = away.interpolate_with(grab, k)
			# Line the magazine up under the well before pushing it home.
			goal.origin += Vector3(0.0, -0.06, 0.0) * sin(PI * k) * k * 1.5
			carrying = true
		elif reload < 0.86:
			var k := (reload - 0.8) / 0.06
			goal = Transform3D(Basis.IDENTITY, GRAB + Vector3(0.0, 0.006 if reload_style == 0 else 0.022, 0.0) * sin(PI * k))
		else:
			var k := smoothstep(0.0, 1.0, (reload - 0.86) / 0.14)
			goal = Transform3D(Basis.IDENTITY, GRAB * (1.0 - k) + arc * sin(PI * k))
	elif inspect > 1.0:
		if inspect <= 2.0:
			var k := smoothstep(0.0, 1.0, inspect - 1.0)
			goal = Transform3D(Basis.IDENTITY, GRAB * k + arc * sin(PI * k))
		else:
			var k := smoothstep(0.0, 1.0, inspect - 2.0)
			var b := Basis(Vector3.BACK, deg_to_rad(-24.0)) * Basis(Vector3.RIGHT, deg_to_rad(36.0)) * Basis(Vector3.UP, deg_to_rad(28.0))
			b = b * Basis.from_euler(Vector3(wobble.y * 0.08, wobble.x * 0.16, 0.0))
			var shown := Transform3D(b, SHOW - b * (FIST + GRAB))
			goal = grab.interpolate_with(transform.affine_inverse() * shown * grab, k)
			# The magazine first drops straight out of the well.
			goal.origin += Vector3(0.0, -0.09, 0.0) * sin(PI * k) * (1.0 - k) * 1.6
			carrying = true
	elif free > 0.001:
		var s := sin(phase)
		var b := Basis(Vector3.RIGHT, deg_to_rad(16.0 + 22.0 * s)) * Basis(Vector3.UP, deg_to_rad(-12.0))
		var pump := Transform3D(b, Vector3(-0.15, -0.243 + 0.08 * s, -0.42 - 0.05 * s) - b * FIST)
		goal = Transform3D.IDENTITY.interpolate_with(transform.affine_inverse() * pump, smoothstep(0.0, 1.0, free))

	# A little smoothing keeps the arm from snapping when an action is broken off.
	_arm = _arm.interpolate_with(goal, 1.0 - exp(-26.0 * dt))
	left_arm.transform = _arm
	# The magazine rides rigidly in the hand; it only blends when picked up or put back.
	_held = move_toward(_held, 1.0 if carrying else 0.0, dt / 0.1)
	mag.transform = Transform3D.IDENTITY.interpolate_with(_arm * grab.affine_inverse(), _held)


func _make_materials() -> void:
	weapon_mat = ShaderMaterial.new()
	weapon_mat.shader = load("res://weapon.gdshader")
	weapon_mat.set_shader_parameter("grime", Assets.grime())
	weapon_mat.set_shader_parameter("scratch_d", Assets.tex("blue_metal_plate_diffuse.jpg", true))
	weapon_mat.set_shader_parameter("scratch_n", Assets.tex("blue_metal_plate_nor_gl.jpg"))
	weapon_mat.set_shader_parameter("camo", Assets.camo())
	weapon_mat.set_shader_parameter("grain_n", Assets.tex("rubberized_track_nor_gl.jpg"))

	# Gloves and sleeves share one shader that picks the surface per mesh zone.
	cloth = Assets.cloth(55.0)

	flash_mat = ShaderMaterial.new()
	flash_mat.shader = load("res://flash.gdshader")


func _part(file: String, mat: Material) -> MeshInstance3D:
	if file == "":
		var blank := MeshInstance3D.new()
		blank.material_override = mat
		blank.layers = 2
		_parent.add_child(blank)
		return blank
	var mesh := Assets.mesh(file)
	var m := MeshInstance3D.new()
	# Sleeves sit mostly below the picture; their shadow is not worth a pass over 400,000 triangles.
	if file.ends_with("_sleeve.bin"):
		m.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	m.mesh = mesh
	m.material_override = mat
	# Drawn with its own field of view, so the usual frustum test would cull it too early.
	m.extra_cull_margin = 4.0
	_parent.add_child(m)
	return m


func _flash_part(parent: Node3D, mesh: QuadMesh, kind: float) -> MeshInstance3D:
	var m := MeshInstance3D.new()
	m.mesh = mesh
	m.material_override = flash_mat
	m.extra_cull_margin = 4.0
	m.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	m.layers = 2
	m.set_instance_shader_parameter("kind", kind)
	parent.add_child(m)
	return m


# One shot's flash: every part gets its own random shape and size.
func fire_flash(side_ports: bool, bright := 1.0) -> void:
	fx_age = 0.0
	fx_time = 0.045 + 0.03 * minf(flash_size, 2.2)
	fx_side = side_ports
	flash_mesh.visible = true
	fx_star.rotation.z = randf() * TAU
	for part: MeshInstance3D in fx_balls + fx_tongues + fx_jets:
		part.set_instance_shader_parameter("seed", randf())
		part.set_instance_shader_parameter("power", randf_range(0.85, 1.2))
		part.set_instance_shader_parameter("bright", bright)
		part.set_meta("len", randf_range(0.65, 1.3))
	for jet: MeshInstance3D in fx_jets:
		jet.visible = side_ports
	_animate_flash(0.0)


func _animate_flash(dt: float) -> void:
	if not flash_mesh.visible:
		return
	# Never more than a 60th of a second per frame: a hitch must not swallow the flash.
	fx_age += minf(dt, 1.0 / 60.0) / fx_time
	if fx_age >= 1.0:
		flash_mesh.visible = false
		return
	var a := fx_age
	var size := flash_size
	# The ball swells as it burns; the tongues shoot out at once and then shrink back.
	for i in fx_balls.size():
		var ball: MeshInstance3D = fx_balls[i]
		var s := (0.07 - 0.02 * i) * size * (0.55 + 0.75 * sqrt(a))
		ball.scale = Vector3.ONE * s
		ball.position = Vector3(0.0, 0.0, -s * 0.45 - 0.004 - 0.02 * i * size)
		ball.set_instance_shader_parameter("age", a)
	var reach := smoothstep(0.0, 0.18, a) * (1.0 - 0.45 * a)
	for t: MeshInstance3D in fx_tongues:
		var l := 0.16 * size * float(t.get_meta("len", 1.0)) * reach
		t.scale = Vector3(0.05 * size * (1.0 - 0.3 * a), maxf(l, 0.001), 1.0)
		t.set_instance_shader_parameter("age", a)
	for jet: MeshInstance3D in fx_jets:
		var l := 0.11 * size * float(jet.get_meta("len", 1.0)) * reach
		jet.scale = Vector3(0.045 * size, maxf(l, 0.001), 1.0)
		jet.set_instance_shader_parameter("age", a)


func _process(dt: float) -> void:
	_animate_flash(dt)


func _build_flash() -> void:
	flash = OmniLight3D.new()
	flash.position = MUZZLE + Vector3(0, 0, -0.04)
	flash.light_color = Color(1.0, 0.8, 0.45)
	flash.omni_range = 6.0
	flash.light_energy = 0.0
	add_child(flash)

	# Muzzle flash: a boiling fireball facing the camera, flame tongues shooting
	# forward out of the muzzle and, with a brake, jets out of its side ports.
	var fx := Node3D.new()
	fx.position = MUZZLE
	add_child(fx)
	var quad := QuadMesh.new()
	quad.size = Vector2.ONE
	var tongue_quad := QuadMesh.new()
	tongue_quad.size = Vector2.ONE
	tongue_quad.center_offset = Vector3(0.0, 0.5, 0.0)       # starts at the muzzle, runs along +Y
	for i in 2:
		var ball := _flash_part(fx, quad, 0.0)
		ball.position = Vector3(0, 0, -0.03 - 0.035 * i)
		fx_balls.append(ball)
	var star := Node3D.new()
	fx.add_child(star)
	fx_star = star
	for i in 4:
		var arm := Node3D.new()
		arm.rotation.z = i * PI / 4.0
		star.add_child(arm)
		var t := _flash_part(arm, tongue_quad, 1.0)
		t.rotation.x = -PI / 2.0                              # +Y now points forward, out of the barrel
		fx_tongues.append(t)
	for side: float in [-1.0, 1.0]:
		var jet := _flash_part(fx, tongue_quad, 1.0)
		jet.position = Vector3(0, 0, 0.045)                   # at the brake's ports
		jet.rotation.z = -side * PI / 2.0
		fx_jets.append(jet)
	fx.visible = false
	flash_mesh = fx
